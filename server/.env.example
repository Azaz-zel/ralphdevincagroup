PORT=3001

# MySQL (Laragon: root with no password). Create the database, then load schema.sql and seed.sql.
DATABASE_URL=mysql://root:@127.0.0.1:3306/rdv_group

# Signs admin sessions. At least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Where this API is reached from the browser, used to build photo URLs.
PUBLIC_URL=http://localhost:3001
# Uploaded photos are written here. Keep it on a persistent disk in production.
UPLOADS_DIR=uploads

# Origins allowed to call the API, comma separated.
CLIENT_ORIGINS=http://localhost:5173

# Set to 1 when running behind one reverse proxy, so rate limits see the visitor's IP.
TRUST_PROXY=0
